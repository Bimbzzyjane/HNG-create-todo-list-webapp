# TaskNest server configuration
# Copy this file to ".env" and adjust the values you need.

# Port the Express API listens on
PORT=5000

# development | test | production
NODE_ENV=development

# Comma separated list of allowed browser origins.
# Leave empty in development to reflect the request origin.
# CLIENT_ORIGIN=http://localhost:5173

# Load the demo todos and notes when the server starts (true | false)
SEED_DATA=true

# Maximum JSON request body size
JSON_LIMIT=100kb
