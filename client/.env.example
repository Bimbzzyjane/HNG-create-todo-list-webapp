# TaskNest client configuration
# Copy this file to ".env" only if you need to change the defaults.

# Base URL of the REST API.
# Leave empty during development: Vite proxies /api to the Express server.
# VITE_API_BASE_URL=http://localhost:5000/api

# Where the Vite dev server proxy should send /api requests.
# VITE_PROXY_TARGET=http://localhost:5000
